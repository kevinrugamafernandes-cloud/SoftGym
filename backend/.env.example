APP_NAME=SoftGym
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
# Solo para depurar: imprime cada consulta SQL (con datos de socios) en los logs.
SQL_ECHO=false
# Supabase: use el "connection pooler" (puerto 6543) en producción.
DATABASE_URL=postgresql://postgres:CAMBIE-ESTA-CLAVE@db.your-project.supabase.co:5432/postgres

# Clave con la que se FIRMAN los JWT. Obligatoria y de >= 32 caracteres cuando
# ENVIRONMENT != development. Debe ser ALEATORIA (no una frase):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambie-esto-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
ALGORITHM=HS256
# Duración del token (la app lo renueva sola mientras se usa) y tope absoluto de una sesión.
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_MAX_HOURS=16
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# /docs y /redoc: por defecto solo en desarrollo. Descomente para forzar.
# ENABLE_API_DOCS=false

# ── Protección del login ──
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_MINUTES=10

# ── Administrador inicial (desarrollador) ──
# Si ambos están definidos, al arrancar se crea esta cuenta de administrador si no existe.
# Nunca sobrescribe una cuenta existente. Ponga los valores reales SOLO en backend/.env
# (ignorado por Git) o en las variables del servidor, nunca aquí.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Desarrollador

# ── Consulta de cédula (Fácil Inscripción) ──
CEDULA_LOOKUP_ENABLED=true
CEDULA_LOOKUP_URL=https://api.hacienda.go.cr/fe/ae
CEDULA_LOOKUP_TIMEOUT_SECONDS=5
# "nombre_primero"  -> "ANA MARIA MORA SOLANO"   |  "apellidos_primero" -> "MORA SOLANO ANA MARIA"
CEDULA_LOOKUP_NAME_ORDER=nombre_primero

# ── Pruebas (opcional): BD dedicada, su nombre DEBE terminar en _test ──
# TEST_DATABASE_URL=postgresql://softgym:softgym_dev_password@db:5432/softgym_test

# ── Membresías ──
# Días antes del vencimiento en que el socio pasa a "por vencer"
MEMBERSHIP_EXPIRING_DAYS=5
# Días de gracia tras vencer antes de marcarlo "moroso" (0 = moroso desde el día siguiente)
MEMBERSHIP_GRACE_DAYS=0
